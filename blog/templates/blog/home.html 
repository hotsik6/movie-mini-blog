{% extends 'blog/base.html' %}

{% block content %}

<h1>Movie Posts</h1>

{% for post in posts %}

    <div>

        <h2>
            {{ post.title }}
        </h2>

        <p>
            {{ post.content }}
        </p>

        <small>
            By {{ post.author_name }}
        </small>

        <hr>

    </div>

{% endfor %}

{% endblock %}